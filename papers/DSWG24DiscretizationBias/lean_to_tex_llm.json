      "prompt_version": "lean-to-tex-v3-strict-context-free-semantic-inputs",
      "tex_statement": "If $rule(x)=y$ for every joint outcome $(x,y)$ in $\\mu$, then for every label $y$, $bias_\\mu(rule,prior_\\mu,y)=0$.",
      "translated_at": "2026-06-29T18:08:26Z",
