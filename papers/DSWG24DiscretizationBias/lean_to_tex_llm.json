      "prompt_version": "lean-to-tex-v3-strict-context-free-semantic-inputs",
      "tex_statement": "For finite-label finite-measure spaces, if $argmaxRule$ is measurable, is an argmax rule for $q$, $q$ is a posterior simplex, each $q(\\cdot,y)$ is measurable, and $q$ is calibrated under $\\mu$, then for every label $y$, $continuousJointPriorBias_\\mu(argmaxRule,y)\\le continuousJointClassifierMAE_\\mu(q)$.",
      "translated_at": "2026-06-29T18:08:26Z",
      "translator": "codex-gpt-5.5-semantic-rejudge",
      "validator_type": "model"
