    "theorem1i_no_information_bias": {
      "lean_statement_sha256": "2a89ce90d390fbe36f3cfc02fe917d31d01a8c2f7db49992d82b081ff4dedb7f",
      "prompt_version": "lean-to-tex-v3-strict-context-free-semantic-inputs",
      "tex_statement": "If $q(x,a)=prior_\\mu(a)$ for all $x,a$ and $z$ has maximal prior probability, then for every label $y$, both $bias_\\mu(x\\mapsto z,prior_\\mu,y)$ and $bias_\\mu(x\\mapsto z,aggregatePosterior_\\mu(q),y)$ equal $1-prior_\\mu(y)$ if $z=y$, and $-prior_\\mu(y)$ otherwise.",
      "translated_at": "2026-06-29T18:08:26Z",
      "translator": "codex-gpt-5.5-semantic-rejudge",
      "validator_type": "model"
    },
