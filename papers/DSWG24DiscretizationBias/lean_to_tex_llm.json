    "theorem2iii_non_argmax_not_pareto": {
      "lean_statement_sha256": "685071cd3243e352e47a982257f9f33240372f853fc3cd473e9f24ad0b89c721",
      "prompt_version": "lean-to-tex-v3-strict-context-free-semantic-inputs",
      "tex_statement": "For finite $X$, if $\\Pr_\\mu[rule\\ne argmaxRule]>0$, $N>0$, $pref$ is a probability vector with $pref(y)\\ge 1/N$, and $argmaxRule$ weakly maximizes $posterior(x,\\cdot)$ for every $x$, then the sampled decision induced by $rule$ is not Pareto optimal for expected dataset accuracy and expected dataset fidelity.",
